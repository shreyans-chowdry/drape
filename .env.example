# Copy to .env.local for development. Never commit real values.
# Public (sent to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=            # from `npx supabase start` or the Supabase dashboard
NEXT_PUBLIC_GOOGLE_AUTH=false                    # true once the Google provider is configured in Supabase
NEXT_PUBLIC_SUPPORT_EMAIL=                       # optional public support address; the contact form works without it

# Server only
SUPABASE_SECRET_KEY=                             # service role / secret key — server only
GEMINI_API_KEY=                                  # Google AI Studio key — server only
ADMIN_EMAILS=                                    # comma-separated emails allowed into /admin
CRON_SECRET=                                     # random string; Vercel Cron sends it as a Bearer token

# Payments (Razorpay test mode first: rzp_test_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend). Without these, emails are logged as "not configured" and not sent.
RESEND_API_KEY=
EMAIL_FROM=                                      # e.g. "Drape <hello@your-verified-domain>"
